# WalletConnect Cloud project ID (required for WalletConnect / mobile wallets)
# Get one at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Alchemy API key (recommended for reliable Base + Ethereum RPCs)
# Get one at https://www.alchemy.com
NEXT_PUBLIC_ALCHEMY_KEY=

# Optional Infura project ID (alternative / fallback RPC)
NEXT_PUBLIC_INFURA_KEY=

# Optional Railgun Private POI aggregator (default: https://ppoi.fdi.network)
NEXT_PUBLIC_RAILGUN_POI_NODE=

# Set to 1 to forward Railgun engine debug logs to the console
NEXT_PUBLIC_RAILGUN_DEBUG=
